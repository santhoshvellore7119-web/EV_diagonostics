<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="ev_battery_pack">
    <static>false</static>
    <link name="chassis">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>45.0</mass>
        <inertia>
          <ixx>1.25</ixx>
          <iyy>3.40</iyy>
          <izz>4.10</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.80 0.50 0.20</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.80 0.50 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.18 0.22 1.0</ambient>
          <diffuse>0.25 0.30 0.38 1.0</diffuse>
          <specular>0.6 0.6 0.6 1.0</specular>
        </material>
      </visual>

      <!-- Cell 1 Contact Pad -->
      <visual name="cell_1_visual">
        <pose>-0.25 0 0.105 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.40 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.2 1.0</ambient>
          <diffuse>0.2 0.8 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- Cell 2 Contact Pad -->
      <visual name="cell_2_visual">
        <pose>0.0 0 0.105 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.40 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.2 1.0</ambient>
          <diffuse>0.2 0.8 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- Cell 3 Contact Pad -->
      <visual name="cell_3_visual">
        <pose>0.25 0 0.105 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.40 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.2 1.0</ambient>
          <diffuse>0.2 0.8 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- Thermal Sensor Plugin Interface -->
      <sensor name="pack_thermal_sensor" type="camera">
        <pose>0 0 0.40 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
