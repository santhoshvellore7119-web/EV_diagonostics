<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="ev_battery_pack">
    <static>false</static>

    <!-- Main Module Enclosure & Thermal Baseplate -->
    <link name="chassis">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>8.50</mass>
        <inertia>
          <ixx>0.085</ixx>
          <iyy>0.240</iyy>
          <izz>0.310</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.40 0.15 0.10</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.40 0.15 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.15 0.20 1.0</ambient>
          <diffuse>0.22 0.28 0.35 1.0</diffuse>
          <specular>0.7 0.7 0.7 1.0</specular>
        </material>
      </visual>

      <!-- Aluminum Cooling Fin Base -->
      <visual name="heatsink_fins">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry>
          <box>
            <size>0.38 0.14 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1.0</ambient>
          <diffuse>0.5 0.5 0.55 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Cell 1 (18650 Cylindrical Link) -->
    <link name="cell_1">
      <pose>-0.12 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.048</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="cell_1_col">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="cell_1_vis">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.3 1.0</ambient>
          <diffuse>0.2 0.8 0.4 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Cell 2 (18650 Cylindrical Link) -->
    <link name="cell_2">
      <pose>-0.04 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.048</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="cell_2_col">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="cell_2_vis">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.3 1.0</ambient>
          <diffuse>0.2 0.8 0.4 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Cell 3 (18650 Cylindrical Link) -->
    <link name="cell_3">
      <pose>0.04 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.048</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="cell_3_col">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="cell_3_vis">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.3 1.0</ambient>
          <diffuse>0.2 0.8 0.4 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Cell 4 (18650 Cylindrical Link) -->
    <link name="cell_4">
      <pose>0.12 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.048</mass>
        <inertia>
          <ixx>0.000025</ixx>
          <iyy>0.000025</iyy>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="cell_4_col">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="cell_4_vis">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.2 0.2 1.0</ambient>
          <diffuse>0.9 0.3 0.3 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Active Rebalancer Module Link -->
    <link name="rebalancer_power_stage">
      <pose>0 0.05 0.105 0 0 0</pose>
      <visual name="pcb_vis">
        <geometry>
          <box>
            <size>0.28 0.04 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.3 0.1 1.0</ambient>
          <diffuse>0.1 0.5 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joints attaching cells to chassis -->
    <joint name="chassis_to_cell1" type="fixed">
      <parent>chassis</parent>
      <child>cell_1</child>
    </joint>
    <joint name="chassis_to_cell2" type="fixed">
      <parent>chassis</parent>
      <child>cell_2</child>
    </joint>
    <joint name="chassis_to_cell3" type="fixed">
      <parent>chassis</parent>
      <child>cell_3</child>
    </joint>
    <joint name="chassis_to_cell4" type="fixed">
      <parent>chassis</parent>
      <child>cell_4</child>
    </joint>
    <joint name="chassis_to_rebalancer" type="fixed">
      <parent>chassis</parent>
      <child>rebalancer_power_stage</child>
    </joint>

    <!-- Multi-Spectral Thermal Camera Sensor Plugin -->
    <sensor name="pack_thermal_imager" type="camera">
      <pose>0 0 0.35 0 1.5708 0</pose>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.15</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>3.0</far>
        </clip>
      </camera>
    </sensor>
  </model>
</sdf>
